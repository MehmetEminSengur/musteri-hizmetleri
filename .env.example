# Bu dosyayı .env adıyla kopyalayın ve değerleri KENDİNİZ yazın.
# .env hiçbir yere gönderilmez (.gitignore içinde). Anahtarları yapay zekâ sohbetine yapıştırmayın.
# Değerleri nereden alacağınız: docs/meta-kurulum.md ve docs/shopify.md

# --- Meta uygulaması (developers.facebook.com → Uygulamanız → Ayarlar → Temel) ---
META_APP_ID=
META_APP_SECRET=

# --- Sistem kullanıcısı erişim anahtarı (business.facebook.com → İşletme ayarları → Sistem kullanıcıları) ---
META_ACCESS_TOKEN=

# --- Facebook sayfası (Instagram ve Messenger mesajları bu sayfa üzerinden gelir) ---
META_PAGE_ID=

# --- WhatsApp (developers.facebook.com → Uygulamanız → WhatsApp → API Kurulumu) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Shopify ---
# Anahtar GEREKMEZ: `node bin/musteri.mjs shopify-baglan` tarayıcıda tek onayla bağlar.
# Aşağıdakiler yalnız config.json → store.auth = "app" seçildiyse doldurulur.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
